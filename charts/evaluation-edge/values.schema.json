{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gatewayClassName", "controllerName", "gateway", "hostnames", "routeNamespaces", "issuerName", "stewardCa"],
  "properties": {
    "gatewayClassName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63 },
    "controllerName": { "type": "string", "minLength": 1 },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "listener"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 52 },
        "listener": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63 }
      }
    },
    "hostnames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" }
    },
    "routeNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" }
    },
    "issuerName": { "type": "string", "minLength": 1 },
    "stewardCa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "secretName", "configMapName"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string", "minLength": 1 },
        "configMapName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
