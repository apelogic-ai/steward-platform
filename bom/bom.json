  "dependencies": {
    "cert-manager": {
      "description": "Issues the Steward API and webhook certificates and injects the webhook CA bundle, through the Steward chart's certManager TLS mode. The reference install uses it in every environment; an operator who already runs cert-manager can keep theirs.",
      "version": "1.21.2",
      "source": "https://cert-manager.io",
      "usage": "reference-install",
      "requiredFor": ["core", "task-auth", "browser-admin"],
      "chart": {
        "reference": "oci://quay.io/jetstack/charts/cert-manager",
        "version": "v1.21.2",
