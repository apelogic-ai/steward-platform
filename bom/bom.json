        "startupapicheck": "quay.io/jetstack/cert-manager-startupapicheck:v1.21.2@sha256:46e75b6866359ffb5d82624f41e3ed1c70b2994982702ced547ce5edb418a8f5",
        "acmesolver": "quay.io/jetstack/cert-manager-acmesolver:v1.21.2@sha256:699b40d622211ab7accad8a21b04c5fbaa1841ef7a12621e8de492dbe27b2503"
      }
    },
    "postgresql": {
      "description": "Database for Steward. Evaluation and tests only; production installs use a separately operated PostgreSQL, version 16 or later (minVersion). The core end-to-end test runs on every tested version; version and images are the default that the reference install and the other end-to-end tests use.",
      "version": "16.14",
      "minVersion": "16",
      "source": "https://www.postgresql.org",
      "usage": "evaluation-only",
      "requiredFor": ["core", "task-auth", "browser-admin"],
      "images": {
        "postgres": "docker.io/library/postgres:16.14-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777"
      },
      "tested": [
        {
          "version": "16.14",
          "images": {
            "postgres": "docker.io/library/postgres:16.14-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777"
          }
        },
        {
          "version": "17.11",
          "images": {
            "postgres": "docker.io/library/postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"
          }
        }
      ]
    },
    "gateway-api-crds": {
      "description": "Gateway API CRDs, standard channel, which the task-auth and browser-admin edge uses for its Gateway, HTTPRoutes and BackendTLSPolicy. The release Envoy Gateway 1.9.1 bundles; Steward needs v1.4.0 or later. The reference install server-side applies the manifest, so upgrades update the CRDs.",
      "version": "1.6.1",
      "source": "https://gateway-api.sigs.k8s.io",
      "usage": "reference-install",
      "requiredFor": ["task-auth", "browser-admin"],
      "manifests": [
        {
          "url": "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.1/standard-install.yaml",
          "digest": "sha256:24d931f22abd8e40c973264319ead7cfa09d0fb7716b7ab1ee2ff174cb063a73",
          "fluxSource": {
            "git": {
              "repository": "https://github.com/kubernetes-sigs/gateway-api",
              "tag": "v1.6.1",
              "commit": "8bb74df00e56ec8f944d48c25e6c1c9c2f6848e3",
              "path": "config/crd/standard"
            }
          }
        }
      ]
    },
    "envoy-gateway": {
      "description": "Gateway API implementation for the task-auth and browser-admin edge. Steward's chart names Envoy Gateway v1.9.1 as its tested controller line. The reference installs install it in every environment; an operator who already runs an implementation with BackendTLSPolicy support can keep theirs. Its CRDs are server-side applied from its release manifest rather than installed by Helm: Envoy Gateway's CRD chart is too large to be stored as a Helm release.",
      "version": "1.9.1",
      "source": "https://gateway.envoyproxy.io",
      "usage": "reference-install",
      "requiredFor": ["task-auth", "browser-admin"],
      "chart": {
        "reference": "oci://docker.io/envoyproxy/gateway-helm",
        "version": "v1.9.1",
        "digest": "sha256:91bae9aedb91ab34731e987afe01a3ccf454393015abeca705eea8ee15553e86"
      },
      "images": {
        "controller": "docker.io/envoyproxy/gateway:v1.9.1@sha256:0049bcb384c591c6a6dd043fe5c9929ef6e74f230e12dd678d2d3701df9b301e",
        "proxy": "docker.io/envoyproxy/envoy:distroless-v1.39.1@sha256:eb2c01c13125d1629637cb4e4cce7207009fb7cc2c8027f9742758549d15b6f4"
      },
      "manifests": [
        {
          "url": "https://github.com/envoyproxy/gateway/releases/download/v1.9.1/envoy-gateway-crds.yaml",
          "digest": "sha256:613fac22b8673735e97fd2523098974bd74cb0cc78e444602b3383d1217b8aab",
          "fluxSource": {
            "chart": {
              "path": "gateway-helm/charts/crds/crds/generated"
            }
          }
        }
      ]
    }
  },
  "profiles": {
    "core": {
      "description": "Steward API, admission webhook and controller with a PostgreSQL database, and cert-manager for service TLS. No agent execution.",
      "products": ["steward"],
      "dependencies": ["cert-manager", "postgresql"]
    },
    "task-auth": {
      "description": "Core plus github-oidc-exchange behind an Envoy Gateway edge, exercised by the steward-run GitHub Action: proves Task authentication with real GitHub Actions OIDC. No agent execution.",
      "products": ["steward", "github-oidc-exchange", "steward-run"],
      "dependencies": ["cert-manager", "postgresql", "gateway-api-crds", "envoy-gateway"]
    },
    "browser-admin": {
      "description": "task-auth plus Steward's browser web UI and Google Workspace login, routed through Steward's own Gateway API routes: proves the administrator surfaces (templates, Envelope requests, approvals, audit) install and are reachable. steward-run's release coordinates are projected into Steward for browser workflow generation. No agent execution.",
      "products": ["steward", "github-oidc-exchange", "steward-run"],
      "dependencies": ["cert-manager", "postgresql", "gateway-api-crds", "envoy-gateway"]
    }
  }
