# Reference install of the Steward platform: the core, task-auth and
# browser-admin profiles. See README.md in this directory.
#
# Every input comes from scripts/generate.sh, which reads one platform values
# file and the BOM. Generate first, then pick the matching environment:
#
#   scripts/generate.sh environments/kind/platform-values.yaml
#   helmfile -f helmfile/helmfile.yaml.gotmpl -e kind sync
#
# To add an environment, add an entry below whose name matches the
# `environment` field of its platform values file. PLATFORM_GENERATED_DIR
# points at another output root than ../generated (scripts/generate.sh --out
# <root>/<environment>).
{{- $root := env "PLATFORM_GENERATED_DIR" | default "../generated" }}
environments:
  kind:
    values:
      - {{ $root }}/kind/helmfile.yaml
  kind-task-auth:
    values:
      - {{ $root }}/kind-task-auth/helmfile.yaml
  kind-browser-admin:
    values:
      - {{ $root }}/kind-browser-admin/helmfile.yaml
  production:
    values:
      - {{ $root }}/production/helmfile.yaml
---
{{- $generated := printf "%s/%s/values" (env "PLATFORM_GENERATED_DIR" | default "../generated") .Environment.Name }}
{{- $releases := .Values.releases }}
{{- $ns := .Values.namespaces }}

helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  createNamespace: true

releases:
{{- if $releases.certManager.enabled }}
  # cert-manager from the BOM, pinned by chart digest. Its CRDs are chart
  # templates, so upgrades update them.
  - name: cert-manager
    namespace: {{ $ns.certManager }}
    chart: {{ $releases.certManager.chart }}
    values:
      - {{ $generated }}/cert-manager.yaml
{{- end }}

{{- if $releases.evaluationCa.enabled }}
  # Evaluation only: a self-signed CA Issuer for Steward's certificates.
  - name: evaluation-ca
    namespace: {{ $ns.steward }}
    chart: ../charts/evaluation-ca
    {{- if $releases.certManager.enabled }}
    needs:
      - {{ $ns.certManager }}/cert-manager
    {{- end }}
    values:
      - {{ $generated }}/evaluation-ca.yaml
{{- end }}

{{- if $releases.postgresqlEvaluation.enabled }}
  # Evaluation only: in-cluster PostgreSQL without persistence or TLS. It also
  # writes the Steward database Secret.
  - name: postgresql-evaluation
    namespace: {{ $ns.steward }}
    chart: ../charts/postgresql-evaluation
    values:
      - {{ $generated }}/postgresql-evaluation.yaml
{{- end }}

  # Steward from the BOM, pinned by chart digest (version {{ $releases.steward.version }}).
  # Helm installs its CRD from the chart's crds/ directory on first install
  # only; see README.md for upgrades.
  - name: steward
    namespace: {{ $ns.steward }}
    chart: {{ $releases.steward.chart }}
    {{- if or $releases.certManager.enabled $releases.evaluationCa.enabled $releases.postgresqlEvaluation.enabled }}
    needs:
      {{- if $releases.certManager.enabled }}
      - {{ $ns.certManager }}/cert-manager
      {{- end }}
      {{- if $releases.evaluationCa.enabled }}
      - {{ $ns.steward }}/evaluation-ca
      {{- end }}
      {{- if $releases.postgresqlEvaluation.enabled }}
      - {{ $ns.steward }}/postgresql-evaluation
      {{- end }}
    {{- end }}
    values:
      - {{ $generated }}/steward.yaml

{{- if $releases.envoyGateway.enabled }}

  # task-auth and browser-admin: Envoy Gateway from the BOM, pinned by chart digest, without its
  # bundled CRDs. Its Envoy proxies run in this namespace. First, the BOM's
  # Gateway API (standard channel) and Envoy Gateway CRD manifests are
  # checked against their digests and server-side applied, so upgrades update
  # them (Envoy Gateway's CRD chart is too large for a Helm release).
  - name: envoy-gateway
    namespace: {{ $ns.edge }}
    chart: {{ $releases.envoyGateway.chart }}
    hooks:
      - events: ["presync"]
        showlogs: true
        # Hooks run in this directory, against PLATFORM_KUBE_CONTEXT or else
        # the current kubeconfig context.
        command: ../scripts/apply-manifests.sh
        args:
          - --context
          - "{{ env "PLATFORM_KUBE_CONTEXT" }}"
          - gateway-api-crds
          - envoy-gateway
    values:
      - {{ $generated }}/envoy-gateway.yaml
{{- end }}

{{- if $releases.edgeEvaluationCa.enabled }}

  # Evaluation only: a second self-signed CA, for the edge listener
  # certificate.
  - name: edge-evaluation-ca
    namespace: {{ $ns.gateway }}
    chart: ../charts/evaluation-ca
    {{- if $releases.certManager.enabled }}
    needs:
      - {{ $ns.certManager }}/cert-manager
    {{- end }}
    values:
      - {{ $generated }}/edge-evaluation-ca.yaml
{{- end }}

{{- if $releases.evaluationEdge.enabled }}

  # Evaluation only: the Envoy Gateway GatewayClass and Gateway, and the public
  # ConfigMap of the evaluation Steward CA (read from the cluster, so Steward
  # goes first).
  - name: evaluation-edge
    namespace: {{ $ns.gateway }}
    chart: ../charts/evaluation-edge
    needs:
      - {{ $ns.edge }}/envoy-gateway
      - {{ $ns.gateway }}/edge-evaluation-ca
      - {{ $ns.steward }}/steward
    values:
      - {{ $generated }}/evaluation-edge.yaml
{{- end }}

{{- if $releases.stewardEdge.enabled }}

  # task-auth: Steward's task API routes and the BackendTLSPolicy to the
  # apiserver.
  - name: steward-edge
    namespace: {{ $ns.steward }}
    chart: ../charts/steward-edge
    needs:
      - {{ $ns.steward }}/steward
      {{- if $releases.envoyGateway.enabled }}
      - {{ $ns.edge }}/envoy-gateway
      {{- end }}
    values:
      - {{ $generated }}/steward-edge.yaml
{{- end }}

{{- if $releases.identityExchange.enabled }}

  # task-auth and browser-admin: github-oidc-exchange from the BOM, pinned by chart digest
  # (version {{ $releases.identityExchange.version }}). Its policy ConfigMap and
  # keyring Secret must exist first; the chart only references them.
  - name: github-oidc-exchange
    namespace: {{ $ns.identityExchange }}
    chart: {{ $releases.identityExchange.chart }}
    {{- if $releases.envoyGateway.enabled }}
    needs:
      - {{ $ns.edge }}/envoy-gateway
    {{- end }}
    values:
      - {{ $generated }}/github-oidc-exchange.yaml
{{- end }}
